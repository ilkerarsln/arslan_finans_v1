{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "type": { "type": "string", "enum": ["Gelir", "Gider", "Transfer", "Mal Alımı"] },
        "category": { "type": "string" },
        "cariId": { "type": "string" },
        "cariName": { "type": "string" },
        "desc": { "type": "string" },
        "amount": { "type": "number" },
        "accountId": { "type": "string" },
        "targetAccountId": { "type": "string" },
        "status": { "type": "string", "enum": ["Tamamlandı", "Beklemede", "İptal"] },
        "documentNo": { "type": "string" },
        "createdAt": { "type": "string" },
        "installmentIndex": { "type": "number" },
        "totalInstallments": { "type": "number" },
        "installmentGroupId": { "type": "string" }
      },
      "required": ["id", "userId", "date", "type", "category", "amount", "accountId", "status"]
    },
    "Account": {
      "title": "Account",
      "description": "Bank account or cash register",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "iban": { "type": "string" },
        "balance": { "type": "number" },
        "currency": { "type": "string", "enum": ["TRY", "USD", "EUR"] },
        "creditLimit": { "type": "number" },
        "cutOffDate": { "type": "string" },
        "cutOffDay": { "type": "number" },
        "color": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "userId", "name", "type", "balance", "currency"]
    },
    "Cari": {
      "title": "Cari",
      "description": "Customer, vendor, or contact account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Müşteri", "Tedarikçi", "Personel", "Diğer"] },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "taxNumber": { "type": "string" },
        "taxOffice": { "type": "string" },
        "city": { "type": "string" },
        "balance": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "name", "type", "balance"]
    },
    "UpcomingDue": {
      "title": "UpcomingDue",
      "description": "Upcoming debt or receivable due item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["Gelir", "Gider"] },
        "amount": { "type": "number" },
        "dueDate": { "type": "string" },
        "cariId": { "type": "string" },
        "cariName": { "type": "string" },
        "category": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "recurrence": { "type": "string", "enum": ["Tek Seferlik", "Aylık", "Yıllık"] },
        "accountId": { "type": "string" },
        "installmentIndex": { "type": "number" },
        "totalInstallments": { "type": "number" },
        "installmentGroupId": { "type": "string" }
      },
      "required": ["id", "userId", "title", "type", "amount", "dueDate", "category", "isCompleted"]
    },
    "Category": {
      "title": "Category",
      "description": "Finance category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Gelir", "Gider"] },
        "color": { "type": "string" }
      },
      "required": ["id", "userId", "name", "type"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and authorization role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Standart"] },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "assignedBy": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "StaffAccount": {
      "title": "StaffAccount",
      "description": "Personnel username/password authentication record and role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Standart"] },
        "password": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "username", "role", "password"]
    },
    "DeletionRequest": {
      "title": "DeletionRequest",
      "description": "Approval request by standard user to delete or cancel a transaction or cari",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["transaction", "cari"] },
        "targetId": { "type": "string" },
        "targetTitle": { "type": "string" },
        "amount": { "type": "number" },
        "requestedBy": { "type": "string" },
        "requestedByName": { "type": "string" },
        "requestedAt": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["id", "userId", "targetType", "targetId", "status", "requestedBy"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Detailed audit trail of financial actions and user operations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "description": { "type": "string" },
        "performedBy": { "type": "string" },
        "performedByName": { "type": "string" },
        "userRole": { "type": "string" },
        "timestamp": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "userId", "action", "description", "performedBy", "timestamp"]
    }
  },
  "firestore": {
    "/staff_accounts/{staffId}": {
      "schema": "StaffAccount",
      "description": "Personnel accounts for username/password authentication"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and role access information"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "User bank and cash accounts"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User income, expense, and transfer transactions"
    },
    "/users/{userId}/caris/{cariId}": {
      "schema": "Cari",
      "description": "User customer and vendor contacts"
    },
    "/users/{userId}/upcomingDues/{dueId}": {
      "schema": "UpcomingDue",
      "description": "User payment calendar and installment dues"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "User income/expense categories"
    },
    "/users/{userId}/deletionRequests/{requestId}": {
      "schema": "DeletionRequest",
      "description": "Pending deletion requests requiring admin approval"
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": "AuditLogEntry",
      "description": "Audit trail log records of all system actions"
    }
  }
}
