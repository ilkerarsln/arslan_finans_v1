rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ilkerarslan78@gmail.com' ||
        request.auth.token.email == 'arslanmobilya78@gmail.com' ||
        request.auth.token.email == 'projebao@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    match /staff_accounts/{staffId} {
      allow read: if true;
      allow write: if isAdmin() || !exists(/databases/$(database)/documents/staff_accounts/$(staffId));
    }

    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin() || isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /accounts/{accountId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(accountId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /transactions/{transactionId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(transactionId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /caris/{cariId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(cariId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /upcomingDues/{dueId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(dueId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /categories/{categoryId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(categoryId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /deletionRequests/{requestId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(requestId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /auditLogs/{logId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(logId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /stocks/{stockId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(stockId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /priceLists/{priceListId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(priceListId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /sales/{saleId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(saleId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /purchases/{purchaseId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(purchaseId);
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /ciroMatrix/{ciroId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(ciroId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
