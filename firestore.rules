rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(accountId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      match /caris/{cariId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(cariId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      match /upcomingDues/{dueId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(dueId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(categoryId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
