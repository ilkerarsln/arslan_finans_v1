rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ilkerarslan78@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // Staff accounts collection for username/password authentication & management
    match /staff_accounts/{staffId} {
      allow read: if true;
      allow write: if isAdmin() || !exists(/databases/$(database)/documents/staff_accounts/$(staffId));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin() || isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /accounts/{accountId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(accountId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /transactions/{transactionId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(transactionId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /caris/{cariId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(cariId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /upcomingDues/{dueId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(dueId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /categories/{categoryId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(categoryId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
